rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Products images
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Combos images
    match /combos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

